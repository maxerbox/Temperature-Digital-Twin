{
  "allow_edit": true,
  "header_image": "",
  "datasources": [
    {
      "name": "Sensors",
      "type": "HF Dataset Viewer",
      "settings": {
        "dataset": "maxerbox/temperature_digital_twin",
        "config": "pvvx_sensors",
        "split": "train",
        "date_filter": "today",
        "refresh": 300
      }
    }
  ],
  "panes": [
    {
      "title": "Date Selection",
      "width": 1,
      "row": { "4": 1 },
      "col": { "4": 1 },
      "widgets": [
        {
          "type": "Date Picker",
          "settings": {
            "title": "Select Date",
            "datasource_name": "Sensors",
            "initial_date": "today"
          }
        }
      ]
    },
    {
      "title": "Hugging Face",
      "width": 1,
      "row": { "4": 1 },
      "col": { "4": 2 },
      "widgets": [
        {
          "type": "Link Card",
          "settings": {
            "url": "https://huggingface.co/datasets/maxerbox/temperature_digital_twin",
            "emoji": "\ud83e\udd17",
            "title": "Hugging Face Source Dataset",
            "subtitle": "maxerbox/temperature_digital_twin",
            "open_new_tab": true
          }
        }
      ]
    },
    {
      "title": "Sensor Status",
      "width": 1,
      "row": { "4": 1 },
      "col": { "4": 3 },
      "widgets": [
        {
          "type": "text_widget",
          "settings": {
            "title": "Sensors Online",
            "size": "big",
            "value": "datasources[\"Sensors\"].sensor_count",
            "sparkline": false,
            "animate": true,
            "units": ""
          }
        },
        {
          "type": "text_widget",
          "settings": {
            "title": "Readings",
            "size": "regular",
            "value": "datasources[\"Sensors\"].filtered_rows",
            "sparkline": false,
            "animate": true,
            "units": ""
          }
        },
        {
          "type": "text_widget",
          "settings": {
            "title": "Last Reading",
            "size": "regular",
            "value": "datasources[\"Sensors\"].last_reading_ts",
            "sparkline": false,
            "animate": false,
            "units": ""
          }
        },
        {
          "type": "text_widget",
          "settings": {
            "title": "Data Refreshed",
            "size": "regular",
            "value": "datasources[\"Sensors\"].last_updated_display",
            "sparkline": false,
            "animate": false,
            "units": ""
          }
        }
      ]
    },
    {
      "title": "Temperature (°C) - All Sensors",
      "width": 2,
      "row": { "4": 2 },
      "col": { "4": 1 },
      "widgets": [
        {
          "type": "Time Series Chart",
          "settings": {
            "title": "Temperature Over Time",
            "data_source": "datasources[\"Sensors\"]",
            "metric": "tempc",
            "show_legend": true,
            "height": 10
          }
        }
      ]
    },
    {
      "title": "Humidity (%) - All Sensors",
      "width": 2,
      "row": { "4": 3 },
      "col": { "4": 3 },
      "widgets": [
        {
          "type": "Time Series Chart",
          "settings": {
            "title": "Humidity Over Time",
            "data_source": "datasources[\"Sensors\"]",
            "metric": "hum",
            "show_legend": true,
            "height": 10
          }
        }
      ]
    }
  ],
  "columns": 4
}
